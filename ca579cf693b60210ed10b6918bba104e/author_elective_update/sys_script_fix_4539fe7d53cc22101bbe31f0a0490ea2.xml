    <sys_script_fix action="DELETE">
        <before>false</before>
        <description>Posts message to Teams channel that a cluster is down</description>
        <name>Ada NXT Send cluster down messages</name>
        <record_for_rollback>true</record_for_rollback>
        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // Define the message content
    var message = "TESTING IGNORE - Cluster is down " ;

    // Create a new Integration Hub action
    var teamsAction = new sn_ms_teams.TeamsAction();
    teamsAction.postMessage({
        channel: "19%3Aa17d990b27eb49c4aee4d1265c3ed089%40thread.skype",
        text: message
    });

})(current, previous);
]]></script>
