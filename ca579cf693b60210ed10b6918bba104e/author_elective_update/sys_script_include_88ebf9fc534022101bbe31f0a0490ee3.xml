        <name>Ada Get AWS instance statuses</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[const axios = require('axios');
const cheerio = require('cheerio');

async function fetchPage(url) {
    try {
        const response = await axios.get(url);
        const html = response.data;

        const $ = cheerio.load(html);
        console.log("Captured Splash Page:", $.html());
    } catch (error) {
        console.error("Error fetching page:", error);
    }
}

// Example usage
fetchPage("https://rxw-nxt.statuspage.io/");


// Example usage:
fetchAndExtractElement("https://rxw-nxt.statuspage.io/", "h1").then((text) => {
    console.log("Extracted Element Text:", text);
});
]]></script>
