        <script><![CDATA[// Loop through Ada NXT Instances table to get list of AWS sites, and for each
//   Check status using HTTP request to its Status URL
//   Update the record

var url_to_check = '';
var gdt = new GlideDateTime();
gs.info('Current date and time (UTC): ' + gdt.getValue());
gs.info('Current date and time (local): ' + gdt.getDisplayValue());

var gr = new GlideRecord('u_ada_nxt_instances');
gr.query();
while (gr.next()) {
    url_to_check = 	gr.u_status_page_url ;
	var request = new GlideHTTPRequest(url_to_check);
	var response = request.get();
	var responseBody = response.getBody();
	var searchString = "All Systems Operational";

	if (responseBody.includes(searchString)) {
	//	gs.info('Found the string: ' + searchString + ' on ' + gr.u_status_page_url);
		gr.u_all_operational = true ;
	} else {
	//	gs.info('String not found.');
		gr.u_all_operational = false ;
	}

	gr.u_last_operational_check = gdt.getValue() ;

    gr.update();

}
]]></script>
